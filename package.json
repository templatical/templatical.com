{
  "name": "templatical-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests vite.config.ts vitest.config.ts tsconfig.json README.md .claude",
    "format:check": "prettier --check src tests vite.config.ts vitest.config.ts tsconfig.json README.md .claude"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
