    "@unhead/vue": "2.1.17",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^15.0.0",
    "clsx": "^2.1.1",
    "focus-trap": "8.2.4",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@templatical/types": "^0.53.0",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-ssg": "28.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.14"
  }
